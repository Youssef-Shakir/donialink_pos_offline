#. module: donialink_pos_offline
#: model:ir.model.fields,field_description:donialink_pos_offline.field_pos_config__dl_offline_mode
#: model:ir.model.fields,field_description:donialink_pos_offline.field_res_config_settings__pos_dl_offline_mode
#: model_terms:ir.ui.view,arch_db:donialink_pos_offline.res_config_settings_view_form
msgid "Offline Mode"
msgstr "وضع العمل دون اتصال"

#. module: donialink_pos_offline
#: model:ir.model.fields,help:donialink_pos_offline.field_pos_config__dl_offline_mode
#: model:ir.model.fields,help:donialink_pos_offline.field_res_config_settings__pos_dl_offline_mode
msgid "Open this point of sale and sell without internet. Orders made offline are sent when the server can be reached again. Needs HTTPS."
msgstr "فتح نقطة البيع والبيع دون إنترنت. تُرسل الطلبات التي تمت دون اتصال عند إمكانية الوصول إلى الخادم مجدداً. يتطلب HTTPS."

#. module: donialink_pos_offline
#: model_terms:ir.ui.view,arch_db:donialink_pos_offline.res_config_settings_view_form
msgid "Open the POS and sell without internet; orders are sent when the connection is back. Closing the register always needs internet."
msgstr "فتح نقطة البيع والبيع دون إنترنت؛ تُرسل الطلبات عند عودة الاتصال. إغلاق الصندوق يتطلب الإنترنت دائماً."

#. module: donialink_pos_offline
#: model_terms:ir.ui.view,arch_db:donialink_pos_offline.res_config_settings_view_form
msgid "Needs HTTPS. Open the POS once online after switching it on."
msgstr "يتطلب HTTPS. افتح نقطة البيع مرة واحدة مع الاتصال بعد التفعيل."

#. module: donialink_pos_offline
#. odoo-javascript
#: code:addons/donialink_pos_offline/static/src/offline_monitor.js
msgid "Some orders could not be sent yet. They will be tried again."
msgstr "لم يتم إرسال بعض الطلبات بعد. ستتم إعادة المحاولة."

#. module: donialink_pos_offline
#. odoo-javascript
#: code:addons/donialink_pos_offline/static/src/offline_monitor.js
msgid "The server can't be reached. Connect to the internet and try again."
msgstr "لا يمكن الوصول إلى الخادم. اتصل بالإنترنت وحاول مرة أخرى."

#. module: donialink_pos_offline
#. odoo-javascript
#: code:addons/donialink_pos_offline/static/src/offline_monitor.js
msgid "Some orders are still waiting to be sent. Refresh after they are sent."
msgstr "ما زالت بعض الطلبات بانتظار الإرسال. حدّث البيانات بعد إرسالها."

